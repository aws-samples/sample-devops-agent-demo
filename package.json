{
    "name": "devopsagent",
    "description": "project description",
    "version": "4.0.0",
    "author": "AWS Technical Product Marketing",
    "license": "Apache License Version 2.0",
    "private": true,
    "bin": {
        "app": "bin/app.js"
    },
    "workspaces": [
        "lib/stacks/frontend/app"
    ],
    "scripts": {
        "preinstall": "npm config set registry=https://registry.npmjs.com/",
        "postinstall": "uv venv --allow-existing && uv tool install ruff && bash scripts/patch-minimatch.sh",
        "prepare": "husky",
        "format": "prettier --write . && ruff format .",
        "lint": "eslint . && ruff check .",
        "kit": "npx tsx tools/cli.ts",
        "export": "npx tsx tools/export.ts",
        "consolidate:analyze": "npx tsx tools/consolidation-analyzer.ts",
        "consolidate:cli": "npx tsx tools/consolidation-cli.ts",
        "stage": "npx generate-changelog && git add -A",
        "commit": "npx cz",
        "build": "tsc",
        "watch": "tsc -w",
        "test": "jest",
        "cdk": "npx aws-cdk@2.1109.0"
    },
    "lint-staged": {},
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "engines": {
        "node": "22.8.0"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudformation": "^3.857.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.857.0",
        "@aws-sdk/client-secrets-manager": "^3.857.0",
        "@aws-sdk/credential-providers": "^3.857.0",
        "@inquirer/prompts": "^7.8.0",
        "@types/archiver": "^6.0.3",
        "@types/aws-lambda": "^8.10.152",
        "@types/jest": "^29.5.14",
        "@types/node": "22.7.9",
        "@types/pg": "^8.11.0",
        "@typescript-eslint/eslint-plugin": "^8.37.0",
        "@typescript-eslint/parser": "^8.37.0",
        "archiver": "^7.0.1",
        "aws-cdk": "^2.1109.0",
        "case": "1.6.3",
        "chalk": "4.1.0",
        "commander": "^14.0.0",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "fast-json-patch": "3.1.1",
        "globals": "^15.15.0",
        "husky": "^9.1.6",
        "jest": "^29.7.0",
        "lint-staged": "^15.5.2",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.1",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.37.0",
        "yaml": "^2.8.0"
    },
    "overrides": {
        "minimatch@<4": "3.1.5",
        "minimatch@>=5 <6": "5.1.9",
        "minimatch@>=9 <10": "9.0.9",
        "minimatch@>=10": "10.2.4",
        "fast-xml-parser@<4.5.1": "4.5.4"
    },
    "dependencies": {
        "@aws-amplify/data-construct": "^1.16.3",
        "@aws-cdk/aws-lambda-python-alpha": "^2.241.0-alpha.0",
        "@aws-sdk/client-codebuild": "^3.857.0",
        "@aws-sdk/client-s3": "^3.857.0",
        "@aws/pdk": "^0.26.15",
        "@cdklabs/generative-ai-cdk-constructs": "^0.1.309",
        "aws-appsync": "^4.1.10",
        "aws-cdk-lib": "^2.241.0",
        "cdk-nag": "^2.37.53",
        "constructs": "^10.4.2",
        "pg": "^8.13.1",
        "source-map-support": "^0.5.21"
    }
}
